# Shell scripts must keep LF endings even when checked out on Windows.
# With CRLF the shebang line becomes "#!/usr/bin/env bash\r" and the script
# dies immediately on Linux — often silently, with exit code 0, because
# `set -euo pipefail` itself fails to parse.
*.sh text eol=lf

# Same reasoning for anything else executed on the server.
*.conf text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Python runs fine either way, but keep the tree consistent.
*.py text eol=lf
*.xml text eol=lf
*.csv text eol=lf
