<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tp_nesting_run_wizard_form" model="ir.ui.view">
        <field name="name">tp.nesting.run.wizard.form</field>
        <field name="model">tp.nesting.run.wizard</field>
        <field name="arch" type="xml">
            <form string="New Nesting Runs" create="false">
                <header>
                    <button name="action_new_batch_set"
                            type="object"
                            string="New"
                            class="btn-secondary"/>
                    <button name="action_refresh"
                            type="object"
                            string="Refresh Batches"
                            class="btn-secondary"/>
                    <button name="action_preview_all"
                            type="object"
                            string="Preview"
                            class="btn-secondary"
                            invisible="selected_group_count == 0"/>
                    <button name="action_run"
                            type="object"
                            string="Run Nesting"
                            class="btn-primary"
                            invisible="selected_group_count == 0"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done,failed"/>
                </header>
                <sheet>
                    <div class="row o_tp_nesting_wizard_app">
                        <div class="col-12 col-xl-5">
                            <group>
                                <group>
                                    <field name="nesting_input_mode" widget="radio"/>
                                    <field name="group_count" readonly="1"/>
                                    <field name="selected_group_count" readonly="1"/>
                                </group>
                                <group>
                                    <field name="panel_count_preview" readonly="1"/>
                                    <field name="cnc_panel_count_preview" readonly="1"/>
                                </group>
                            </group>
                            <group string="Cutting Allowances">
                                <group>
                                    <field name="kerf_mm"/>
                                </group>
                            </group>
                            <group string="CSV Panel Import">
                                <group>
                                    <field name="manual_import_csv_only" invisible="1"/>
                                    <field name="candidate_source_product_ids" invisible="1"/>
                                    <field name="source_product_id"
                                           string="CSV Source Sheet"
                                           domain="[('id', 'in', candidate_source_product_ids)]"
                                           options="{'no_create': True, 'no_open': True}"
                                           invisible="nesting_input_mode != 'csv_only'"/>
                                    <field name="manual_import_line_id"
                                           string="Add CSV Panels To"
                                           domain="[('wizard_id', '=', id)]"
                                           options="{'no_create': True, 'no_open': True}"
                                           invisible="nesting_input_mode == 'csv_only'"/>
                                    <field name="csv_file" filename="csv_filename"/>
                                    <field name="csv_filename" invisible="1"/>
                                </group>
                                <group>
                                    <field name="manual_import_count" readonly="1"/>
                                    <button name="action_import_manual_csv"
                                            type="object"
                                            string="Import CSV Panels"
                                            class="btn-secondary"
                                            invisible="not csv_file"/>
                                    <button name="action_clear_manual_imports"
                                            type="object"
                                            string="Clear CSV Panels"
                                            class="btn-secondary"
                                            invisible="manual_import_count == 0"/>
                                </group>
                            </group>
                            <group string="Batch Summary">
                                <field name="batch_summary" nolabel="1" readonly="1"/>
                            </group>
                            <group string="Material Batches">
                                <field name="line_ids" nolabel="1">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="selected" widget="boolean_toggle"/>
                                        <field name="group_label"/>
                                        <field name="panel_quantity"/>
                                        <field name="panel_count"/>
                                        <field name="cnc_panel_count"/>
                                        <field name="source_product_id"
                                               options="{'no_create': True, 'no_quick_create': True}"
                                               domain="[('id', 'in', candidate_source_product_ids)]"/>
                                        <field name="warning"/>
                                        <field name="candidate_source_product_ids" column_invisible="1"/>
                                        <field name="part_ids" column_invisible="1"/>
                                        <field name="group_key" column_invisible="1"/>
                                        <field name="material_type" column_invisible="1"/>
                                        <field name="thickness_mm" column_invisible="1"/>
                                        <field name="colour" column_invisible="1"/>
                                        <field name="finish" column_invisible="1"/>
                                        <field name="protective_film" column_invisible="1"/>
                                        <field name="brand_supplier" column_invisible="1"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Imported CSV Panel Lines" invisible="manual_import_count == 0">
                                <field name="manual_line_ids" nolabel="1">
                                    <list editable="bottom" create="0" delete="1">
                                        <field name="batch_line_id"
                                               readonly="1"
                                               options="{'no_open': True}"/>
                                        <field name="label"/>
                                        <field name="width_mm"/>
                                        <field name="height_mm"/>
                                        <field name="quantity"/>
                                        <field name="part_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Preview Summary" invisible="not preview_summary">
                                <field name="preview_summary" nolabel="1" readonly="1"/>
                            </group>
                        </div>
                        <div class="col-12 col-xl-7">
                            <group string="Sheet Preview" invisible="not preview_svg">
                                <field name="preview_svg" nolabel="1" readonly="1" widget="html"/>
                            </group>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tp_nesting_run_wizard" model="ir.actions.act_window">
        <field name="name">New Nesting Runs</field>
        <field name="res_model">tp.nesting.run.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="action_tp_nesting_live_app" model="ir.actions.client">
        <field name="name">Live Nesting</field>
        <field name="tag">tp_sheet_nesting_run.live_app</field>
        <field name="target">current</field>
    </record>

    <menuitem id="tp_sheet_nesting.menu_tp_sheet_nesting_root"
              name="Sheet Nesting"
              action="action_tp_nesting_live_app"
              sequence="20"/>

    <record id="action_tp_nesting_run_wizard_server" model="ir.actions.server">
        <field name="name">New Nesting Runs</field>
        <field name="model_id" ref="tp_sheet_nesting.model_tp_nesting_run"/>
        <field name="state">code</field>
        <field name="code">action = env["tp.nesting.run.wizard"].action_open_new()</field>
    </record>

    <menuitem id="menu_tp_nesting_run_wizard"
              name="Live Nesting"
              parent="tp_sheet_nesting.menu_tp_sheet_nesting_root"
              action="action_tp_nesting_live_app"
              sequence="25"/>
</odoo>
