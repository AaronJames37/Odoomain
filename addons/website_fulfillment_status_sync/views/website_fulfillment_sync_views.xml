<odoo>
    <record id="view_website_fulfillment_sync_log_list" model="ir.ui.view">
        <field name="name">website.fulfillment.sync.log.list</field>
        <field name="model">website.fulfillment.sync.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date"/>
                <field name="storefront_order_id"/>
                <field name="odoo_order_name_hint"/>
                <field name="odoo_order_id_hint"/>
                <field name="fulfillment_status"/>
                <field name="state"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_website_fulfillment_sync_log_form" model="ir.ui.view">
        <field name="name">website.fulfillment.sync.log.form</field>
        <field name="model">website.fulfillment.sync.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="storefront_order_id"/>
                            <field name="odoo_order_id_hint"/>
                            <field name="odoo_order_name_hint"/>
                        </group>
                        <group>
                            <field name="fulfillment_status"/>
                            <field name="state"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Raw Payload">
                        <field name="raw_json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_website_fulfillment_sync_log" model="ir.actions.act_window">
        <field name="name">Website Fulfillment Sync Logs</field>
        <field name="res_model">website.fulfillment.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_website_fulfillment_root"
              name="Website Fulfillment"
              parent="sale.sale_menu_root"
              sequence="90"
              groups="sales_team.group_sale_manager"/>
    <menuitem id="menu_website_fulfillment_logs"
              name="Sync Logs"
              parent="menu_website_fulfillment_root"
              action="action_website_fulfillment_sync_log"
              sequence="10"/>
</odoo>
