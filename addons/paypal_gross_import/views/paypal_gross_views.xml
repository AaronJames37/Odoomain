<odoo>
    <record id="view_paypal_gross_connection_list" model="ir.ui.view">
        <field name="name">paypal.gross.connection.list</field>
        <field name="model">paypal.gross.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="environment"/>
                <field name="journal_id"/>
                <field name="auto_import"/>
                <field name="last_paypal_updated_at"/>
                <field name="last_successful_import_at"/>
                <field name="transaction_count"/>
            </list>
        </field>
    </record>

    <record id="view_paypal_gross_connection_form" model="ir.ui.view">
        <field name="name">paypal.gross.connection.form</field>
        <field name="model">paypal.gross.connection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fetch_new_transactions" type="object" string="Fetch New Transactions" class="btn-primary"/>
                    <button name="action_fetch_from_start_date" type="object" string="Fetch From Start Date"/>
                    <button name="action_test_connection" type="object" string="Test Connection"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_transactions" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="auto_import"/>
                            <field name="company_id"/>
                            <field name="environment"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="paypal_client_id"/>
                            <field name="paypal_client_secret" password="True"/>
                            <div class="o_form_label">Transaction Currency</div>
                            <div>AUD</div>
                            <field name="import_start_date"/>
                        </group>
                    </group>
                    <group string="Sync Cursor">
                        <field name="lookback_hours"/>
                        <field name="limit_per_run"/>
                        <field name="last_paypal_updated_at"/>
                        <field name="last_successful_import_at"/>
                    </group>
                    <group string="Last Import Details">
                        <field name="last_import_summary" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_paypal_gross_connection" model="ir.actions.act_window">
        <field name="name">PayPal Gross Connections</field>
        <field name="res_model">paypal.gross.connection</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_paypal_gross_transaction_list" model="ir.ui.view">
        <field name="name">paypal.gross.transaction.list</field>
        <field name="model">paypal.gross.transaction</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="paypal_transaction_id"/>
                <field name="paypal_transaction_event_code"/>
                <field name="paypal_transaction_status"/>
                <field name="gross_amount"/>
                <field name="fee_amount"/>
                <field name="net_amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="statement_line_id"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="view_paypal_gross_transaction_form" model="ir.ui.view">
        <field name="name">paypal.gross.transaction.form</field>
        <field name="model">paypal.gross.transaction</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_statement_line" type="object" string="Open Statement Line" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="company_id"/>
                            <field name="journal_id"/>
                            <field name="statement_line_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="paypal_initiation_at"/>
                            <field name="paypal_updated_at"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="PayPal">
                        <field name="paypal_transaction_id"/>
                        <field name="paypal_reference_id"/>
                        <field name="paypal_reference_id_type"/>
                        <field name="paypal_transaction_event_code"/>
                        <field name="paypal_transaction_status"/>
                        <field name="paypal_external_key"/>
                        <field name="description"/>
                    </group>
                    <group string="Amounts">
                        <field name="gross_amount"/>
                        <field name="fee_amount"/>
                        <field name="net_amount"/>
                    </group>
                    <group string="Error">
                        <field name="error_message"/>
                    </group>
                    <group string="Raw PayPal Payload">
                        <field name="raw_json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_paypal_gross_transaction" model="ir.actions.act_window">
        <field name="name">PayPal Gross Transactions</field>
        <field name="res_model">paypal.gross.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_paypal_gross_root" name="PayPal Gross Import" parent="base.menu_config" sequence="81" groups="base.group_system"/>
    <menuitem id="menu_paypal_gross_connections" name="Connections" parent="menu_paypal_gross_root" action="action_paypal_gross_connection" sequence="10" groups="base.group_system"/>
    <menuitem id="menu_paypal_gross_transactions" name="Transactions" parent="menu_paypal_gross_root" action="action_paypal_gross_transaction" sequence="20" groups="base.group_system"/>
</odoo>
