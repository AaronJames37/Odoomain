<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tp_web_cut_part_processing_list" model="ir.ui.view">
        <field name="name">tp.web.cut.part.processing.list</field>
        <field name="model">tp.web.cut.part</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" string="Panels in Website Fulfillment Orders">
                <field name="sale_order_id"/>
                <field name="odoo_order_name" optional="hide"/>
                <field name="sale_order_line_id" optional="hide"/>
                <field name="sku"/>
                <field name="label" optional="show"/>
                <field name="tp_material_type" string="Material"/>
                <field name="tp_thickness_mm" string="Thickness (mm)" sum="Total panels (qty)"/>
                <field name="tp_colour" string="Colour" optional="show"/>
                <field name="tp_finish" string="Finish" optional="hide"/>
                <field name="width_mm"/>
                <field name="height_mm"/>
                <field name="quantity" sum="Total qty"/>
                <field name="shape" optional="show"/>
                <field name="cnc_required" optional="show"/>
                <field name="cnc_operation_summary" optional="show"/>
                <field name="sale_order_fulfillment_status" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_tp_web_cut_part_processing_search" model="ir.ui.view">
        <field name="name">tp.web.cut.part.processing.search</field>
        <field name="model">tp.web.cut.part</field>
        <field name="arch" type="xml">
            <search>
                <field name="sale_order_id"/>
                <field name="odoo_order_name"/>
                <field name="sku"/>
                <field name="tp_material_type" string="Material"/>
                <field name="tp_colour" string="Colour"/>
                <field name="sale_order_fulfillment_status"/>
                <filter name="filter_processing"
                        string="Processing"
                        domain="[('sale_order_fulfillment_status', '=', 'processing')]"/>
                <filter name="filter_cutting"
                        string="Cutting"
                        domain="[('sale_order_fulfillment_status', '=', 'cutting')]"/>
                <filter name="filter_rectangles"
                        string="Rectangles only"
                        domain="[('shape', '=', 'rectangle')]"/>
                <filter name="filter_custom_shapes"
                        string="Custom shapes (CNC)"
                        domain="[('shape', '!=', 'rectangle')]"/>
                <separator/>
                <group>
                    <filter name="group_material"
                            string="Material"
                            context="{'group_by': 'tp_material_type'}"/>
                    <filter name="group_thickness"
                            string="Thickness"
                            context="{'group_by': 'tp_thickness_mm'}"/>
                    <filter name="group_colour"
                            string="Colour"
                            context="{'group_by': 'tp_colour'}"/>
                    <filter name="group_order"
                            string="Sale Order"
                            context="{'group_by': 'sale_order_id'}"/>
                    <filter name="group_status"
                            string="Fulfillment Status"
                            context="{'group_by': 'sale_order_fulfillment_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tp_web_cut_part_processing" model="ir.actions.act_window">
        <field name="name">Active Panels</field>
        <field name="res_model">tp.web.cut.part</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sale_order_fulfillment_status', 'in', ['processing', 'cutting'])]</field>
        <field name="context">{
            'search_default_group_material': 1,
            'search_default_group_thickness': 1,
        }</field>
        <field name="search_view_id" ref="view_tp_web_cut_part_processing_search"/>
        <field name="view_id" ref="view_tp_web_cut_part_processing_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No panels in website fulfillment orders right now
            </p>
            <p>
                This list pulls every <strong>tp.web.cut.part</strong> whose sale order is currently
                marked as <code>processing</code> or <code>cutting</code> by the website sync.
                CNC and non-CNC panels appear together so they can be nested onto the same sheet.
            </p>
        </field>
    </record>

    <menuitem id="menu_tp_web_cut_parts_processing"
              name="Active Panels"
              parent="tp_sheet_nesting.menu_tp_sheet_nesting_root"
              action="action_tp_web_cut_part_processing"
              sequence="45"/>

    <!-- ================================================================
         Trim the Sheet Nesting menu: hide menu entries that duplicate
         functionality reachable elsewhere or are dev-tooling. Each is
         disabled via active=False rather than deleted so it can be
         brought back without re-installing the upstream module.
         ================================================================ -->
    <record id="tp_sheet_nesting.menu_tp_sheet_nesting_allocations" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="tp_sheet_nesting.menu_tp_web_cut_parts" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="tp_sheet_nesting_processing_view.menu_pull_website_fulfillment_jobs" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="tp_sheet_nesting.menu_tp_sheet_nesting_benchmarks" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Surface Optimizer Benchmarks on the Sheet Nesting settings page so
         admins can still reach it without a menu entry. -->
    <record id="view_tp_sheet_nesting_settings_benchmarks_link" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.tp.sheet.nesting.benchmarks_link</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="tp_sheet_nesting.res_config_settings_view_form_tp_sheet_nesting"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='tp_sheet_nesting_settings_container']" position="after">
                <block title="Diagnostics" name="tp_sheet_nesting_diagnostics_container">
                    <setting id="tp_nesting_benchmarks_link_setting"
                             help="Internal optimizer benchmarks. Useful for engine tuning; not needed for daily ops.">
                        <button name="%(tp_sheet_nesting.action_tp_nesting_benchmark)d"
                                type="action"
                                string="Open Optimizer Benchmarks"
                                class="btn-link"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
