<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb document template for a single nesting run -->
    <template id="report_tp_nesting_run_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div style="width:100%; text-align:center;">
                    <t t-raw="doc.nesting_svg or ''"/>
                </div>
                <t t-set="generated_offcuts" t-value="doc.produced_offcut_ids.filtered(lambda row: row.planned_kind == 'offcut')"/>
                <div style="margin-top:18px;">
                    <h3 style="margin:0 0 8px 0;">Generated Offcuts</h3>
                    <t t-if="generated_offcuts">
                        <table style="width:100%; border-collapse:collapse; font-size:12px;">
                            <thead>
                                <tr>
                                    <th style="border:1px solid #bbb; padding:5px; text-align:left;">Offcut ID</th>
                                    <th style="border:1px solid #bbb; padding:5px; text-align:left;">Size</th>
                                    <th style="border:1px solid #bbb; padding:5px; text-align:left;">Source</th>
                                    <th style="border:1px solid #bbb; padding:5px; text-align:left;">Bin</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="generated_offcuts" t-as="row">
                                    <tr>
                                        <td style="border:1px solid #ddd; padding:5px;">
                                            <t t-if="row.offcut_id">#<t t-esc="row.offcut_id.offcut_ref"/></t>
                                            <t t-else="">Planned</t>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:5px;">
                                            <t t-esc="row.width_mm"/> x <t t-esc="row.height_mm"/>mm
                                        </td>
                                        <td style="border:1px solid #ddd; padding:5px;">
                                            <t t-if="row.parent_offcut_id">Offcut #<t t-esc="row.parent_offcut_id.offcut_ref"/></t>
                                            <t t-elif="row.parent_lot_id"><t t-esc="row.parent_lot_id.name"/></t>
                                            <t t-else="">Sheet</t>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:5px;">
                                            <t t-if="row.offcut_id and row.offcut_id.bin_location_id">
                                                <t t-esc="row.offcut_id.bin_location_id.display_name"/>
                                            </t>
                                            <t t-else="">-</t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <p style="font-size:12px; color:#666;">No reusable offcuts generated.</p>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="report_tp_nesting_run">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="tp_sheet_nesting.report_tp_nesting_run_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_tp_nesting_run" model="ir.actions.report">
        <field name="name">Nesting Run Preview</field>
        <field name="model">tp.nesting.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tp_sheet_nesting.report_tp_nesting_run</field>
        <field name="report_file">tp_sheet_nesting.report_tp_nesting_run</field>
        <field name="binding_model_id" ref="model_tp_nesting_run"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Nesting Run - %s' % (object.name or '').replace('/', '_')</field>
    </record>

