<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tp_web_cut_part_list" model="ir.ui.view">
        <field name="name">tp.web.cut.part.list</field>
        <field name="model">tp.web.cut.part</field>
        <field name="arch" type="xml">
            <list>
                <field name="part_key"/>
                <field name="sale_order_id"/>
                <field name="sale_order_line_id"/>
                <field name="line_index"/>
                <field name="panel_index"/>
                <field name="instance_index"/>
                <field name="sku"/>
                <field name="material"/>
                <field name="colour"/>
                <field name="thickness_mm"/>
                <field name="width_mm"/>
                <field name="height_mm"/>
                <field name="shape"/>
                <field name="quantity"/>
            </list>
        </field>
    </record>

    <record id="view_tp_web_cut_part_form" model="ir.ui.view">
        <field name="name">tp.web.cut.part.form</field>
        <field name="model">tp.web.cut.part</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="part_key"/>
                            <field name="website_order_id"/>
                            <field name="website_order_token"/>
                            <field name="sale_order_id"/>
                            <field name="odoo_order_name"/>
                            <field name="sale_order_line_id"/>
                        </group>
                        <group>
                            <field name="line_index"/>
                            <field name="panel_index"/>
                            <field name="instance_index"/>
                            <field name="sku"/>
                            <field name="label"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Envelope">
                            <field name="width_mm"/>
                            <field name="height_mm"/>
                            <field name="quantity"/>
                            <field name="shape"/>
                        </group>
                        <group string="Material">
                            <field name="material"/>
                            <field name="colour"/>
                            <field name="finish"/>
                            <field name="protective_film"/>
                            <field name="brand_supplier"/>
                            <field name="thickness_mm"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Geometry">
                            <group>
                                <field name="radii"/>
                                <field name="holes"/>
                                <field name="cut_outs"/>
                                <field name="custom_shape"/>
                                <field name="geometry_payload"/>
                                <field name="source_payload"/>
                            </group>
                        </page>
                        <page string="Odoo Material Identity">
                            <group>
                                <field name="tp_material_type"/>
                                <field name="tp_thickness_mm"/>
                                <field name="tp_colour"/>
                                <field name="tp_finish"/>
                                <field name="tp_protective_film"/>
                                <field name="tp_brand_supplier"/>
                            </group>
                        </page>
                        <page string="Nesting Links">
                            <group>
                                <field name="mo_cut_line_ids" readonly="1"/>
                                <field name="allocation_ids" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tp_web_cut_part_search" model="ir.ui.view">
        <field name="name">tp.web.cut.part.search</field>
        <field name="model">tp.web.cut.part</field>
        <field name="arch" type="xml">
            <search>
                <field name="part_key"/>
                <field name="website_order_id"/>
                <field name="sale_order_id"/>
                <field name="sale_order_line_id"/>
                <field name="sku"/>
                <field name="material"/>
                <field name="colour"/>
                <field name="shape"/>
                <filter string="Rectangles" name="rectangles" domain="[('shape', '=', 'rectangle')]"/>
                <filter string="Custom Shapes" name="custom_shapes" domain="[('shape', '!=', 'rectangle')]"/>
                <group>
                    <filter string="By Sale Order" name="group_sale_order" context="{'group_by': 'sale_order_id'}"/>
                    <filter string="By Material" name="group_material" context="{'group_by': 'material'}"/>
                    <filter string="By Shape" name="group_shape" context="{'group_by': 'shape'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tp_web_cut_part" model="ir.actions.act_window">
        <field name="name">Website Production Parts</field>
        <field name="res_model">tp.web.cut.part</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tp_web_cut_part_search"/>
    </record>
</odoo>
