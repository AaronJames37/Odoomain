<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_tp_dimensions" model="ir.ui.view">
        <field name="name">sale.order.form.tp.dimensions</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="after">
                <field name="tp_width_mm"/>
                <field name="tp_height_mm"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="after">
                <field name="tp_width_mm" optional="show"/>
                <field name="tp_height_mm" optional="show"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Website Production Parts">
                    <field name="tp_web_cut_part_ids">
                        <list editable="bottom" create="false" delete="false">
                            <field name="part_key" readonly="1"/>
                            <field name="sale_order_line_id" readonly="1"/>
                            <field name="line_index" readonly="1"/>
                            <field name="panel_index" readonly="1"/>
                            <field name="instance_index" readonly="1"/>
                            <field name="sku" readonly="1"/>
                            <field name="label" optional="show"/>
                            <field name="material" readonly="1"/>
                            <field name="colour" readonly="1"/>
                            <field name="thickness_mm" readonly="1"/>
                            <field name="width_mm"/>
                            <field name="height_mm"/>
                            <field name="quantity"/>
                            <field name="shape" readonly="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
